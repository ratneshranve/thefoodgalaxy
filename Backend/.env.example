# Copy this file to .env and fill in the values.
NODE_ENV=development

# ---- Upload storage ---------------------------------------------------------
# Where NEW uploads are stored: local | vps | cloudinary
# Default only. The admin can switch it at runtime in
# Admin Panel > Toggle Management > Upload Storage (that choice wins).
UPLOAD_PROVIDER=local

# local: folder inside the backend project
UPLOAD_LOCAL_DIR=uploads

# vps: folder on your server (create it, give the Node user write access)
UPLOAD_VPS_DIR=/var/www/uploads
# vps: optional public base URL when nginx / a CDN serves that folder directly
# e.g. https://api.yourdomain.com/uploads  (empty = Express serves /uploads)
UPLOAD_VPS_PUBLIC_URL=

# cloudinary: required only when using the cloudinary provider
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
